# Copy this file to ".env" and fill in your real values.  NEVER commit .env!
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_16_char_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Recipient for test emails
TEST_RECIPIENT_EMAIL=your_email@gmail.com

# SMS via email gateway (Thai carriers have no gateway -> SMS is skipped with a warning)
TEST_SMS_PHONE_NUMBER=0812345678
TEST_SMS_CARRIER=ais

# Student info - shown in every email
STUDENT_NAME=ชื่อ นามสกุล
STUDENT_ID=663380372-6
